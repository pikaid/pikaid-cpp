# The official conformance fixture is hashed byte-for-byte by the test suite,
# so its working-tree content must never be subject to line-ending conversion.
# Without this rule a Windows checkout with core.autocrlf converts LF to CRLF
# and the pinned SHA-256 no longer matches the file that is read at run time.
tests/vectors/pikaid-v1.json text eol=lf
